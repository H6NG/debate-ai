{
  "name": "debate-ai",
  "version": "1.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "desktop:dev": "electron .",
    "desktop:smoke": "node electron/main.js --smoke",
    "desktop:dist": "next build && electron-builder --mac"
  },
  "build": {
    "appId": "ai.debate.app",
    "productName": "Debate AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      ".next/**/*",
      "public/**/*",
      "package.json"
    ],
    "asarUnpack": [
      ".next/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "H6NG",
        "repo": "debate-ai"
      }
    ]
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.96",
    "@ai-sdk/google": "^4.0.111",
    "@ai-sdk/groq": "^4.0.76",
    "@ai-sdk/openai": "^4.0.108",
    "@ai-sdk/openai-compatible": "^3.0.84",
    "@ai-sdk/perplexity": "^5.0.26",
    "ai": "^7.0.162",
    "electron-updater": "^6.8.11",
    "firebase": "^13.2.0",
    "lucide-react": "^1.67.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
